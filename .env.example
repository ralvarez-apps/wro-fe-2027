# Copy to .env (git-ignored). Read by `pnpm deploy`.
# Token: a Cloudflare API token with Account > Workers Scripts > Edit and Zone > Workers Routes > Edit
# on the zone of SITE_HOST. Keep it as a file outside the repo (mode 0600) and point at it:
CLOUDFLARE_API_TOKEN_FILE=~/Secrets/cloudflare/workers/<token-file>
# (or CLOUDFLARE_API_TOKEN=<the token> directly; it wins when both are set)
CLOUDFLARE_ACCOUNT_ID=
# Bare public hostname and the path the app is served under. Unset SITE_HOST = workers.dev only.
SITE_HOST=wro.ralvarez.dev
SITE_PATH=/fe/2027
# Zone that owns SITE_HOST. Defaults to the last two labels of SITE_HOST.
SITE_ZONE=ralvarez.dev
